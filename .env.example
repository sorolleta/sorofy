# Copia este archivo a .env y rellena los valores. .env no se sube al repo.

# Spotify (Dashboard -> Settings)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/auth/spotify/callback

# JWT propio de la app (genera un secreto aleatorio de 32+ caracteres)
JWT_SECRET=
JWT_ISSUER=samespot-api
JWT_AUDIENCE=samespot-web

# PostgreSQL (usado por Docker Compose para crear la BD y por la API para conectarse)
POSTGRES_USER=samespot
POSTGRES_PASSWORD=
POSTGRES_DB=samespot
